# Copy this file to .env and fill in real values. .env is loaded by
# server.js at startup and must never be committed with real credentials.

# Port the Express API listens on.
PORT=4000

# Secret key used to sign session tokens (HMAC-SHA256). Set this to a long,
# random, unique string in any real deployment — sessions signed with the
# fallback dev secret in backend/auth/tokens.js are not safe to trust.
TASKFLOW_SESSION_SECRET=

# Postgres connection string (Supabase or any Postgres host). This is the
# app's actual database now — required, the app will not start without it.
# Use the "Session pooler" connection string from Supabase (Project Settings
# -> Connect -> Direct tab -> Session pooler), not "Direct connection" — the
# direct host is IPv6-only and won't resolve on most networks.
DATABASE_URL=

# No longer read by the running app (it talks to Postgres exclusively) — kept
# only because backend/database/migrate-data-to-postgres.mjs reads the old
# local SQLite file at this path when moving data into a fresh Postgres
# database. Irrelevant once that one-time migration has been run.
DATABASE_PATH=

# Supabase project URL and API keys (Project Settings -> API), used for
# Storage — chat image uploads. Separate from DATABASE_URL above, which only
# grants raw Postgres access. service_role bypasses Row Level Security, so
# the backend uploads on the user's behalf rather than relying on Supabase
# Auth (this app has its own auth system, not Supabase Auth). anon is safe
# to expose client-side; not currently used, kept for a possible future
# direct-from-browser upload flow.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# SMTP credentials for sending real password-reset emails.
# Leave SMTP_HOST unset to keep using the dev on-screen reset token instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TaskFlow <no-reply@example.com>"

# Base URL of the running frontend, used to build the link inside the
# password-reset email.
APP_URL=http://localhost:5173
